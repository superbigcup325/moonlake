// Lazy scanning and row-group statistics, over embedded fixtures written by
// harness/gen_parquet_stats.py (pyarrow 26; data page v1, PLAIN encoding, no
// compression). mg_stats has four row groups of three rows:
//
//   group 0: grp=0 v=[0,2]    d=2020-01-01 s="g0"
//   group 1: grp=1 v=[1000,1002] d=2020-01-02 s=NULL (the whole group)
//   group 2: grp=2 v=[2000,2002] d=2020-01-03 s="g2"
//   group 3: grp=3 v=[3000,3002] d=2020-01-04 s="g3"
//
// The bytes are embedded so the tests run on every target without touching
// the file system, like the other Parquet fixtures.

///|
fn stats_hex_bytes(text : String) -> Bytes {
  let out = Buffer()
  let mut pending = -1
  for ch in text {
    let code = ch.to_int()
    let value = if code >= 48 && code <= 57 {
      code - 48
    } else if code >= 97 && code <= 102 {
      code - 87
    } else {
      code - 55
    }
    if pending < 0 {
      pending = value
    } else {
      out.write_byte((pending * 16 + value).to_byte())
      pending = -1
    }
  }
  out.to_bytes()
}

///|
const MG_STATS : String = ""

///|
const TRUNC : String = ""

///|
const NAN : String = ""

///|
const NULLABLE : String = ""

///|
fn fixture(
  text : String,
  table : String,
  date_cols : Array[String],
) -> @catalog.TableEntry {
  @parquet.scan_bytes(stats_hex_bytes(text), table, date_cols) catch {
    e => abort("\{e}")
  }
}

///|
fn batches_of(
  entry : @catalog.TableEntry,
  request : @catalog.ScanRequest,
) -> Array[@types.DataBatch] {
  entry.scan(request) catch {
    e => abort("\{e}")
  }
}

///|
fn plan_of(
  entry : @catalog.TableEntry,
  request : @catalog.ScanRequest,
) -> @catalog.ScanPlan {
  entry.plan(request) catch {
    e => abort("\{e}")
  }
}

///|
fn total_rows(batches : Array[@types.DataBatch]) -> Int32 {
  let mut rows = 0
  for b in batches {
    rows += b.row_count()
  }
  rows
}

///|
fn hint(
  column : Int32,
  op : @types.CmpOp,
  value : @types.Scalar,
) -> @catalog.ScanPredicate {
  { column, op, value, }
}

///|
fn request(
  projection : Array[Int32],
  predicates : Array[@catalog.ScanPredicate],
) -> @catalog.ScanRequest {
  @catalog.ScanRequest::new(projection, predicates)
}

///|
test "registration is lazy: no batch exists until a scan opens" {
  let entry = fixture(MG_STATS, "mg", [])
  assert_true(entry.is_lazy())
  assert_eq(entry.batches.length(), 0)
  assert_eq(entry.schema.columns.length(), 4)
  assert_eq(entry.schema.columns[0].dtype, @types.Int32)
  assert_eq(entry.schema.columns[1].dtype, @types.Int64)
  // d is an INT32 column until --date-col lifts it
  assert_eq(entry.schema.columns[2].dtype, @types.Int32)
  assert_eq(entry.schema.columns[3].dtype, @types.Str)
}

///|
test "each row group is one batch of the scanned table" {
  let entry = fixture(MG_STATS, "mg", [])
  let batches = batches_of(entry, request([0, 1, 2, 3], []))
  assert_eq(batches.length(), 4)
  for b in batches {
    assert_eq(b.row_count(), 3)
  }
  assert_eq(batches[0].columns()[1].get(0), @types.Int64(0))
  assert_eq(batches[2].columns()[1].get(2), @types.Int64(2002))
  assert_eq(batches[1].columns()[3].get(0), @types.Scalar::Null)
  assert_eq(batches[3].columns()[3].get(1), @types.Str("g3"))
}

///|
test "the projection decides which columns are decoded, and in which order" {
  let entry = fixture(MG_STATS, "mg", [])
  let batches = batches_of(entry, request([3, 1], []))
  assert_eq(batches.length(), 4)
  assert_eq(batches[0].columns().length(), 2)
  assert_eq(batches[0].columns()[0].dtype(), @types.Str)
  assert_eq(batches[0].columns()[1].dtype(), @types.Int64)
  assert_eq(batches[0].columns()[0].get(0), @types.Str("g0"))
  // a zero-column projection still reports the row counts
  let empty = batches_of(entry, request([], []))
  assert_eq(empty.length(), 4)
  assert_eq(empty[0].columns().length(), 0)
  assert_eq(empty[0].row_count(), 3)
}

///|
test "statistics skip row groups a predicate cannot match" {
  let entry = fixture(MG_STATS, "mg", [])
  // equality: only group 2 can hold 2001
  let eq = request([1], [hint(1, @types.Eq, @types.Int64(2001L))])
  let plan = plan_of(entry, eq)
  assert_eq(plan.files, 1)
  assert_eq(plan.row_groups, 4)
  assert_eq(plan.row_groups_skipped, 3)
  assert_eq(plan.rows, Some(3L))
  // the hint is advisory: the surviving group comes back whole (3 rows),
  // and the engine's own filter is what keeps the single matching row
  assert_eq(total_rows(batches_of(entry, eq)), 3)
  // range: two groups sit at or above 2000
  let ge = request([1], [hint(1, @types.Ge, @types.Int64(2000L))])
  assert_eq(plan_of(entry, ge).row_groups_skipped, 2)
  assert_eq(total_rows(batches_of(entry, ge)), 6)
  // nothing matches: every group goes, the scan still yields one empty batch
  let none = request([1], [hint(1, @types.Lt, @types.Int64(0L))])
  let plan = plan_of(entry, none)
  assert_eq(plan.row_groups_skipped, 4)
  assert_eq(plan.rows, Some(0L))
  let batches = batches_of(entry, none)
  assert_eq(batches.length(), 1)
  assert_eq(batches[0].row_count(), 0)
  assert_eq(batches[0].columns().length(), 1)
}

///|
test "date and string statistics prune the same way" {
  let entry = fixture(MG_STATS, "mg", ["d"])
  assert_eq(entry.schema.columns[2].dtype, @types.Date)
  // 2020-01-03 = epoch day 18264: groups 0 and 1 are out
  let day = @types.parse_date("2020-01-03").unwrap()
  let by_date = request([2], [hint(2, @types.Ge, @types.Date(day))])
  assert_eq(plan_of(entry, by_date).row_groups_skipped, 2)
  let batches = batches_of(entry, by_date)
  assert_eq(total_rows(batches), 6)
  assert_eq(batches[0].columns()[0].get(0), @types.Date(day))
  // string equality: group 1 holds only NULLs, 0 and 2 hold other values
  let by_string = request([3], [hint(3, @types.Eq, @types.Str("g3"))])
  assert_eq(plan_of(entry, by_string).row_groups_skipped, 3)
  assert_eq(total_rows(batches_of(entry, by_string)), 3)
  // a column that is constant inside a group can eliminate itself
  let constant = request([0], [hint(0, @types.Neq, @types.Int32(2))])
  assert_eq(plan_of(entry, constant).row_groups_skipped, 1)
  assert_eq(total_rows(batches_of(entry, constant)), 9)
}

///|
test "float statistics respect this engine's NaN ordering" {
  // group 0 holds [NaN, 5.0] and its statistics say [5, 5]: writers leave
  // NaN out. The engine compares NaN as equal to everything, so the NaN row
  // satisfies `= 7.0` and the group must not be skipped; a strict comparison
  // is NaN-proof and may prune.
  let entry = fixture(NAN, "nan", [])
  let eq = request([0], [hint(0, @types.Eq, @types.Float64(7.0))])
  assert_eq(plan_of(entry, eq).row_groups_skipped, 0)
  let batches = batches_of(entry, eq)
  assert_eq(total_rows(batches), 3)
  // the NaN row is the one the engine's filter will keep
  assert_true(batches[0].columns()[0].get(0) is @types.Float64(v) && !(v == v))
  let gt = request([0], [hint(0, @types.Gt, @types.Float64(7.0))])
  assert_eq(plan_of(entry, gt).row_groups_skipped, 1)
  assert_eq(total_rows(batches_of(entry, gt)), 1)
  // end to end the NaN row is what the query returns
  let cat = @catalog.Catalog::new()
  cat.register(entry)
  let rows = @engine.run_select(
    "select count(*) as c from nan where f = 7.0", cat,
  ) catch {
    e => abort("\{e}")
  }
  assert_eq(rows.get(0, 0), @types.Int64(1L))
}

///|
test "an all-NULL group is skipped for any comparison" {
  let entry = fixture(NULLABLE, "nl", [])
  let batches = batches_of(entry, request([0, 1], []))
  assert_eq(batches.length(), 1)
  assert_eq(batches[0].row_count(), 3)
  assert_eq(batches[0].columns()[1].get(0), @types.Scalar::Null)
  // statistics say the whole chunk is NULL: no comparison can be true
  let pruned = request([1], [hint(1, @types.Eq, @types.Str("x"))])
  assert_eq(plan_of(entry, pruned).row_groups_skipped, 1)
  assert_eq(total_rows(batches_of(entry, pruned)), 0)
}

///|
test "truncated string statistics are not trusted as bounds" {
  let entry = fixture(TRUNC, "tr", [])
  // the first row is 64 a's followed by b, the second is "z"; statistics for
  // the first group are stored truncated (and marked inexact), so `> 64 a's`
  // must not eliminate it
  let prefix = StringBuilder()
  for _ in 0..<64 {
    prefix.write_char('a')
  }
  let p = request([0], [hint(0, @types.Gt, @types.Str(prefix.to_string()))])
  assert_eq(plan_of(entry, p).row_groups, 2)
  // neither group is eliminated: the hints can only drop data that provably
  // cannot match, and these bounds do not prove it
  let batches = batches_of(entry, p)
  assert_eq(total_rows(batches), 2)
  // both rows are intact, so the engine's own filter can judge them
  let expected = prefix.to_string() + "b"
  assert_eq(batches[0].columns()[0].get(0), @types.Str(expected))
  assert_eq(batches[1].columns()[0].get(0), @types.Str("z"))
}

///|
test "a file without statistics is never pruned" {
  // the DELTA_BINARY_PACKED fixture of colenc_integration_test.mbt has one
  // row group and no statistics: a predicate cannot rule it out
  let entry = fixture(DELTA_INT32, "no_stats", [])
  let p = request([0], [hint(0, @types.Eq, @types.Int32(123456))])
  let plan = plan_of(entry, p)
  assert_eq(plan.row_groups, 1)
  assert_eq(plan.row_groups_skipped, 0)
  assert_true(plan.rows is Some(_))
}

///|
test "engine: a SQL predicate rides on the statistics" {
  let cat = @catalog.Catalog::new()
  cat.register(fixture(MG_STATS, "mg", []))
  let run = fn(sql : String) {
    @engine.run_select(sql, cat) catch {
      e => abort("\{e}")
    }
  }
  let rows = run("select count(*) as c from mg where v >= 2000")
  assert_eq(rows.get(0, 0), @types.Int64(6L))
  let text = @engine.explain(
    "select count(*) as c from mg where v >= 2000", cat,
  ) catch {
    e => abort("\{e}")
  }
  assert_true(text.contains("pushed: v >= 2000"))
  assert_true(
    text.contains("row groups: 2 of 4 read (2 skipped by statistics)"),
  )
  // the same predicate without usable statistics still answers correctly
  let all = run("select count(*) as c from mg where s = 'zzz'")
  assert_eq(all.get(0, 0), @types.Int64(0L))
}
