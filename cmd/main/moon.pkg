import {
  "superbigcup325/moonlake",
  "superbigcup325/moonlake/catalog",
  "superbigcup325/moonlake/engine",
  "superbigcup325/moonlake/platform/io",
  "superbigcup325/moonlake/sources/csv",
  "superbigcup325/moonlake/sources/parquet" @pq,
  "superbigcup325/moonlake/spill",
  "superbigcup325/moonlake/types",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

// platform/io is compiled only for native targets, so the import above is unused
// on wasm-gc/js; -29 is that warning. Package imports are per package, not per
// file, so the gated file below cannot carry the import on its own.

warnings = "-29"

options(
  targets: {
    "mem_rss_native.mbt": [ "native", "llvm" ],
    "mem_rss_native_wbtest.mbt": [ "native", "llvm" ],
    "mem_rss_other.mbt": [ "wasm", "wasm-gc", "js" ],
    "stage_clock_native.mbt": [ "native", "llvm" ],
    "stage_clock_other.mbt": [ "wasm", "wasm-gc", "js" ],
    "spill_owner_native.mbt": [ "native", "llvm" ],
    "spill_owner_native_wbtest.mbt": [ "native", "llvm" ],
    "spill_owner_other.mbt": [ "wasm", "wasm-gc", "js" ],
  },
)
